/*
 * Rofi — launcher moderno ML4W (acento cyan #33ccff)
 */

* {
    background: rgba(15, 23, 42, 0.88);
    foreground: #e2e8f0;
    color0:     #0f172a;
    color1:     #33ccff;
    color2:     #22d3ee;
    color3:     #67e8f9;
    color4:     #33ccff;
    color5:     #06b6d4;
    color6:     #0891b2;
    color7:     #e2e8f0;
    color8:     #64748b;
    color9:     #33ccff;
    color10:    #22d3ee;
    color11:    rgba(51, 204, 255, 0.28);
    color12:    #33ccff;
    color13:    #06b6d4;
    color14:    #0891b2;
    color15:    #f8fafc;
}

* { border-width: 0px; }

configuration {
    modi:                "drun,run";
    font:                "Fira Sans 11";
    show-icons:          true;
    icon-theme:          "Papirus";
    display-drun:        "󰣇  Apps";
    display-run:         "󰜎  Run";
    display-filebrowser: "󰉋  Files";
    display-window:      "󰖯  Window";
    hover-select:        true;
    scroll-method:       1;
    me-select-entry:     "";
    me-accept-entry:     "MousePrimary";
    drun-display-format: "{icon}  {name}";
    window-format:       "{w} · {c} · {t}";
}

window {
    width:            640px;
    x-offset:         0px;
    y-offset:         72px;
    spacing:          0px;
    padding:          0px;
    margin:           0px;
    color:            @foreground;
    border:           2px solid rgba(51, 204, 255, 0.55);
    cursor:           default;
    transparency:     "real";
    location:         north;
    anchor:           north;
    fullscreen:       false;
    enabled:          true;
    border-radius:    18px;
    background-color: transparent;
}

mainbox {
    enabled:          true;
    orientation:      horizontal;
    spacing:          0px;
    margin:           0px;
    background-color: @background;
    border-radius:    16px;
    children:         ["listbox"];
}

imagebox {
    padding:          18px;
    background-color: transparent;
    orientation:      vertical;
    children:         [ "inputbar", "dummy", "mode-switcher" ];
}

listbox {
    spacing:          0px;
    background-color: transparent;
    orientation:      vertical;
    children:         [ "inputbar", "message", "listview" ];
}

dummy {
    background-color: transparent;
}

inputbar {
    enabled:          true;
    text-color:       @foreground;
    spacing:          12px;
    padding:          18px 20px 14px 20px;
    border-radius:    16px 16px 0px 0px;
    border:           0px;
    background-color: rgba(15, 23, 42, 0.95);
    children:         [ "textbox-prompt-colon", "entry" ];
}

textbox-prompt-colon {
    enabled:          true;
    expand:           false;
    padding:          0px;
    str:              "󰍉";
    background-color: transparent;
    text-color:       #33ccff;
}

entry {
    enabled:          true;
    background-color: transparent;
    text-color:       inherit;
    cursor:           text;
    placeholder:      "Buscar aplicaciones…";
    placeholder-color: #64748b;
}

mode-switcher {
    enabled:          true;
    spacing:          12px;
    background-color: transparent;
    text-color:       @foreground;
}

button {
    padding:          8px 16px;
    border-radius:    10px;
    background-color: rgba(255, 255, 255, 0.06);
    text-color:       #94a3b8;
    cursor:           pointer;
    border:           1px solid transparent;
}

button selected {
    background-color: @color11;
    text-color:       #33ccff;
    border:           1px solid rgba(51, 204, 255, 0.45);
}

listview {
    enabled:          true;
    columns:          1;
    lines:            8;
    cycle:            false;
    dynamic:          false;
    scrollbar:        false;
    layout:           vertical;
    reverse:          false;
    fixed-height:     true;
    fixed-columns:    true;
    spacing:          4px;
    padding:          8px 12px 14px 12px;
    margin:           0px;
    background-color: @background;
    border:           0px;
}

element {
    enabled:          true;
    padding:          10px 14px;
    margin:           2px 4px;
    cursor:           pointer;
    background-color: transparent;
    border-radius:    12px;
    border:           0px;
}

element normal.normal {
    background-color: transparent;
    text-color:       @foreground;
}

element normal.urgent {
    background-color: transparent;
    text-color:       @foreground;
}

element normal.active {
    background-color: transparent;
    text-color:       @foreground;
}

element selected.normal {
    background-color: @color11;
    text-color:       #f8fafc;
    border:           1px solid rgba(51, 204, 255, 0.35);
}

element selected.urgent {
    background-color: @color11;
    text-color:       @foreground;
}

element selected.active {
    background-color: @color11;
    text-color:       @foreground;
}

element alternate.normal {
    background-color: transparent;
    text-color:       @foreground;
}

element alternate.urgent {
    background-color: transparent;
    text-color:       @foreground;
}

element alternate.active {
    background-color: transparent;
    text-color:       @foreground;
}

element-icon {
    background-color: transparent;
    text-color:       inherit;
    size:             28px;
    cursor:           inherit;
}

element-text {
    background-color: transparent;
    text-color:       inherit;
    cursor:           inherit;
    vertical-align:   0.5;
    horizontal-align: 0.0;
}

message {
    background-color: transparent;
    border:           0px;
    margin:           12px 0px 0px 0px;
    padding:          0px;
    spacing:          0px;
    border-radius:    12px;
}

textbox {
    padding:          14px;
    margin:           0px;
    border-radius:    12px;
    background-color: @background;
    text-color:       @foreground;
    vertical-align:   0.5;
    horizontal-align: 0.0;
}

error-message {
    padding:          14px;
    border-radius:    14px;
    background-color: @background;
    text-color:       @foreground;
}
